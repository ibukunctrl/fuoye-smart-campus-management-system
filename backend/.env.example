# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (Supabase / Neon Serverless PostgreSQL with PgBouncer connection pooling)
# Example: postgresql://postgres:password@db.supabase.co:5432/postgres?pgbouncer=true&connection_limit=10
DATABASE_URL="postgresql://postgres:password@localhost:5432/fuoye_smart_campus?schema=public"

# Redis Connection (Upstash Redis or Local Redis for Distributed Locking & Caching)
# Example: rediss://default:password@eu-central-1.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-change-in-production-for-fuoye-campus-portal"
JWT_EXPIRES_IN="7d"

# Email Notification Service (Resend SMTP / Gmail / SendGrid)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_your_api_key_here"
EMAIL_FROM="no-reply@fuoye-campus.edu.ng"
